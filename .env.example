# Postmark — AI Support Workspace Environment Configuration
# Copy this file to .env.local and populate your secrets

# AI Provider Configuration
# Set primary provider to 'nvidia' or 'openrouter'
AI_PRIMARY_PROVIDER=nvidia
AI_FALLBACK_PROVIDER=openrouter

# Recommended active models:
# Fast Classifier: meta/llama-3.1-8b-instruct, google/gemma-2-9b-it
# High Reasoning / Draft: nvidia/llama-3.1-nemotron-70b-instruct, meta/llama-3.1-70b-instruct, deepseek-ai/deepseek-r1
AI_CLASSIFIER_MODEL=meta/llama-3.1-8b-instruct
AI_DRAFT_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# OpenRouter fallback model:
AI_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct

# AI Provider API Keys
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Google OAuth & Gmail Integration
# Obtain from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional server tokens (automatically populated upon OAuth consent)
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=

# Supabase PostgreSQL Database (Optional - App includes resilient local persistence out of the box)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
